  "components": [
    {
      "name": "Save Button",
      "kind": "button",
      "refersTo": "button-save",
      "description": "底部固定儲存列的主要動作，分項色實心底＋近黑字。",
      "html": "<button class=\"ds-btn-save\">完成訓練</button>",
      "css": ".ds-btn-save{background:var(--day,#FF8A3D);color:var(--on-accent,#0B0D06);border:none;border-radius:14px;padding:17px 32px;font-size:17px;font-weight:800;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.4);transition:filter .15s}.ds-btn-save:hover{filter:brightness(1.05)}.ds-btn-save:active{filter:brightness(.9)}.ds-btn-save:focus-visible{outline:2px solid var(--day,#FF8A3D);outline-offset:2px}.ds-btn-save:disabled{opacity:.6;cursor:default}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "次要動作（清空）：面板底、hairline 邊、次文字色，字級低於主鍵。",
      "html": "<button class=\"ds-btn-ghost\">清空</button>",
      "css": ".ds-btn-ghost{background:#15171B;color:#9BA1A8;border:1px solid #24272C;border-radius:14px;padding:17px 24px;font-size:14px;font-weight:700;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-btn-ghost:hover{background:#1B1E23;color:#F2F3F5}.ds-btn-ghost:focus-visible{outline:2px solid var(--day,#FF8A3D);outline-offset:2px}"
    },
    {
      "name": "Day Segmented Control",
      "kind": "nav",
      "refersTo": "segmented-tab",
      "description": "三分項切換。被選中那格換凹陷灰底＋抬起陰影，分項色只染文字、不染底。",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\" role=\"tab\" style=\"--c:#FF8A3D\" aria-selected=\"true\">🔥 推 A</button><button class=\"ds-tab\" role=\"tab\" style=\"--c:#5C9EFF\" aria-selected=\"false\">💧 拉 B</button><button class=\"ds-tab\" role=\"tab\" style=\"--c:#82D94F\" aria-selected=\"false\">🌿 腿 C</button></div>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;background:#15171B;border-radius:12px;padding:3px;max-width:420px}.ds-tab{border:none;background:transparent;border-radius:9px;padding:10px 0;font-size:15px;font-weight:700;color:#9BA1A8;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-tab[aria-selected=\"true\"]{color:var(--c);background:#0F1114;font-weight:800;box-shadow:0 1px 2px rgba(0,0,0,.5)}.ds-tab:not([aria-selected=\"true\"]):hover{background:rgba(242,243,245,.05)}.ds-tab:focus-visible{outline:2px solid var(--c);outline-offset:2px}"
    },
    {
      "name": "Goal List",
      "kind": "custom",
      "refersTo": "goal-row",
      "description": "首屏的今天目標清單：狀態圈 × 動作名 × 目標公斤。達標列填綠勾並把文字褪成次階。",
      "html": "<div class=\"ds-goals\"><button class=\"ds-grow\"><span class=\"ds-gmark\" aria-hidden=\"true\">✓</span><span class=\"ds-gname\">胸推機</span><span class=\"ds-gtarget\">42.5<small>kg</small></span></button><button class=\"ds-grow ds-hit\"><span class=\"ds-gmark\" aria-hidden=\"true\">✓</span><span class=\"ds-gname\">肩推機</span><span class=\"ds-gtarget\">27.5<small>kg</small></span></button><button class=\"ds-grow\"><span class=\"ds-gmark\" aria-hidden=\"true\">✓</span><span class=\"ds-gname\">蝴蝶機夾胸</span><span class=\"ds-gtarget\">35<small>kg</small></span></button></div>",
      "css": ".ds-goals{background:#15171B;border-radius:16px;padding:4px 0;box-shadow:0 1px 8px rgba(0,0,0,.35);max-width:420px}.ds-grow{display:flex;align-items:center;gap:12px;width:100%;padding:12px 16px;background:none;border:none;border-bottom:1px solid #24272C;color:#F2F3F5;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif;font-size:15px;cursor:pointer;text-align:left}.ds-grow:last-child{border-bottom:none}.ds-grow:hover{background:rgba(242,243,245,.05)}.ds-grow:active{background:rgba(242,243,245,.08)}.ds-grow:focus-visible{outline:2px solid var(--day,#FF8A3D);outline-offset:-2px}.ds-gmark{flex:0 0 22px;width:22px;height:22px;border-radius:50%;border:2px solid #868C94;display:grid;place-items:center;font-size:12px;color:transparent;transition:background .25s cubic-bezier(.19,1,.22,1),border-color .25s cubic-bezier(.19,1,.22,1)}.ds-hit .ds-gmark{background:#30D158;border-color:#30D158;color:#04220E;animation:ds-pop .35s cubic-bezier(.19,1,.22,1)}@keyframes ds-pop{0%{transform:scale(.6)}60%{transform:scale(1.15)}100%{transform:scale(1)}}.ds-gname{flex:1;min-width:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .25s}.ds-gtarget{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:15px;font-weight:700;color:var(--day,#FF8A3D);font-variant-numeric:tabular-nums;transition:color .25s}.ds-gtarget small{font-size:11px;color:#868C94;font-weight:600;margin-left:2px}.ds-hit .ds-gname,.ds-hit .ds-gtarget{color:#9BA1A8}"
    },
    {
      "name": "Weight Input",
      "kind": "input",
      "refersTo": "input-weight",
      "description": "54px 高的凹陷輸入框，mono 20px tabular，單位貼在框內右側，placeholder 顯示上次重量。",
      "html": "<div class=\"ds-field\"><input class=\"ds-input\" type=\"number\" inputmode=\"decimal\" step=\"0.5\" min=\"0\" placeholder=\"40\" value=\"42.5\" aria-label=\"重量\"><span class=\"ds-unit\">kg</span></div>",
      "css": ".ds-field{position:relative;max-width:180px}.ds-input{width:100%;background:#0F1114;border:1px solid #24272C;border-radius:12px;height:54px;padding:0 40px 0 14px;color:#F2F3F5;font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;caret-color:var(--day,#FF8A3D)}.ds-input::placeholder{color:#868C94}.ds-input:focus{border-color:var(--day,#FF8A3D)}.ds-input:focus:not(:focus-visible){outline:none}.ds-input:focus-visible{outline:2px solid var(--day,#FF8A3D);outline-offset:2px}.ds-unit{position:absolute;right:12px;top:50%;transform:translateY(-50%);font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:11px;color:#868C94;pointer-events:none}"
    },
    {
      "name": "Delta Chip",
      "kind": "chip",
      "refersTo": "chip-delta",
      "description": "即時判讀「比上次多推多少」。四態：未填 / 上升 / 持平 / 下降；底色是低飽和的 color-mix，不是純色。",
      "html": "<span class=\"ds-delta\">今天？</span> <span class=\"ds-delta ds-up\">↑ +2.5</span> <span class=\"ds-delta ds-same\">持平</span> <span class=\"ds-delta ds-down\">↓ -2.5</span>",
      "css": ".ds-delta{display:inline-block;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif;font-weight:700;font-size:14px;border-radius:999px;padding:4px 12px;background:#0F1114;color:#868C94;font-variant-numeric:tabular-nums}.ds-delta.ds-up{background:color-mix(in oklab,#30D158 18%,#0F1114);color:#30D158}.ds-delta.ds-down{background:color-mix(in oklab,#FF6961 14%,#0F1114);color:#FF6961}.ds-delta.ds-same{color:#9BA1A8}"
    },
    {
      "name": "Exercise Card",
      "kind": "card",
      "refersTo": "card-exercise",
      "description": "無邊框面板卡：器械線稿＋動作名 → 目標大數字＋delta chip → 上次最重。",
      "html": "<div class=\"ds-ex\"><div class=\"ds-ex-h\"><svg class=\"ds-mach\" viewBox=\"0 0 130 100\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8,90 H122\" stroke=\"#5C6675\" stroke-width=\"2.5\"/><path d=\"M104,36 h16 v48 h-16 z M104,46 h16 M104,56 h16 M104,66 h16\" stroke=\"#5C6675\" stroke-width=\"2\"/><path d=\"M100,90 V22\" stroke=\"#5C6675\" stroke-width=\"2.5\"/><path d=\"M44,66 H74 M44,66 L39,40\" stroke=\"#5C6675\" stroke-width=\"2.5\"/><circle cx=\"40\" cy=\"30\" r=\"6\" stroke=\"#98A2B0\" stroke-width=\"2.5\"/><path d=\"M42,37 L46,62\" stroke=\"#98A2B0\" stroke-width=\"2.5\"/><path d=\"M46,62 H70 M70,62 V82\" stroke=\"#98A2B0\" stroke-width=\"2.5\"/><path d=\"M43,45 H64\" stroke=\"#98A2B0\" stroke-width=\"2.5\"/><circle cx=\"67\" cy=\"45\" r=\"4\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"2.5\"/><path d=\"M71,45 H96 V26\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"2.5\"/><path d=\"M74,58 H96\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"2.5\"/></svg><div class=\"ds-ex-t\"><div class=\"ds-ex-top\"><div><div class=\"ds-ex-zh\">胸推機</div><div class=\"ds-ex-en\">Chest Press</div></div><div class=\"ds-ex-target\">3 × 10–12</div></div></div></div><div class=\"ds-big\"><span class=\"ds-glabel\">目標</span><span class=\"ds-w\">42.5<small>kg</small></span><span class=\"ds-delta\">今天？</span></div><div class=\"ds-sub\">上次最重 40 kg × 10</div><div style=\"height:16px\"></div></div>",
      "css": ".ds-ex{background:#15171B;border-radius:16px;overflow:hidden;box-shadow:0 1px 8px rgba(0,0,0,.35);max-width:420px;color:#F2F3F5;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif}.ds-ex-h{display:flex;gap:12px;padding:16px 16px 0;align-items:flex-start}.ds-mach{width:88px;height:68px;flex:0 0 88px;background:#0F1114;border-radius:12px}.ds-ex-t{flex:1;min-width:0}.ds-ex-top{display:flex;justify-content:space-between;gap:8px;align-items:baseline}.ds-ex-zh{font-weight:700;font-size:17px;letter-spacing:-.01em}.ds-ex-en{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:10.5px;color:#868C94;letter-spacing:.04em;margin-top:2px}.ds-ex-target{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:11px;color:#9BA1A8;white-space:nowrap}.ds-big{display:flex;align-items:baseline;gap:10px;padding:14px 16px 0}.ds-glabel{font-size:12px;font-weight:700;color:#9BA1A8}.ds-w{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:40px;font-weight:800;letter-spacing:-.03em;line-height:1;color:var(--day,#FF8A3D);font-variant-numeric:tabular-nums}.ds-w small{font-size:14px;color:#9BA1A8;font-weight:600;margin-left:2px}.ds-big .ds-delta{margin-left:auto}.ds-sub{font-size:12.5px;color:#9BA1A8;padding:5px 16px 0;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Progress Sparkline",
      "kind": "custom",
      "refersTo": "card-exercise",
      "description": "最近 10 次的最重組趨勢。preserveAspectRatio=none 讓線撐滿卡片，non-scaling-stroke 讓線寬與點徑不變形，端點數值用 HTML 標籤疊在右側。",
      "html": "<div class=\"ds-sparkrow\"><svg class=\"ds-spark\" viewBox=\"0 0 280 56\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"胸推機 重量趨勢，最近 5 次\"><path d=\"M6.0,46.0 L74.5,36.8 L143.0,28.0 L211.5,17.2 L274.0,10.0\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M6.0,46.0 h0.01\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"6\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" fill=\"none\"><title>2026-07-17　35 kg</title></path><path d=\"M74.5,36.8 h0.01\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"6\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" fill=\"none\"><title>2026-07-24　37.5 kg</title></path><path d=\"M143.0,28.0 h0.01\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"6\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" fill=\"none\"><title>2026-07-31　40 kg</title></path><path d=\"M211.5,17.2 h0.01\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"6\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" fill=\"none\"><title>2026-08-07　42.5 kg</title></path><path d=\"M274.0,10.0 h0.01\" stroke=\"var(--day,#FF8A3D)\" stroke-width=\"6\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" fill=\"none\"><title>2026-08-14　45 kg</title></path></svg><span class=\"ds-sparklabel\" style=\"top:3px\">45kg</span></div>",
